generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id       String   @id @default(cuid())
  username String   @unique
  password String
}

model Berita {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dataset {
  id          String   @id @default(cuid())
  title       String
  description String
  fileCsv     String?
  sizeCsv     String?
  filePdf     String?
  sizePdf     String?
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProdukUnggulan {
  id          String   @id @default(cuid())
  name        String
  description String
  contact     String?
  price       String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  page      String
  updatedAt DateTime @updatedAt
}

model Fasilitas {
  id          String   @id @default(cuid())
  kategori    String
  nama        String
  desa        String
  alamat      String?
  latitude    Float?
  longitude   Float?
  keterangan  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Aparatur {
  id        String   @id @default(cuid())
  nama      String
  jabatan   String
  nip       String?
  golongan  String?
  unit      String
  icon      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Galeri {
  id          String   @id @default(cuid())
  title       String
  category    String
  img         String
  aspectRatio String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pengumuman {
  id        String   @id @default(cuid())
  title     String
  date      String
  category  String
  snippet   String
  isPinned  Boolean  @default(false)
  fileUrl   String?
  fileSize  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  date        String
  time        String
  location    String
  type        String
  status      String   @default("upcoming")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Penghargaan {
  id          String   @id @default(cuid())
  title       String
  year        String
  category    String
  description String
  imageUrl    String?
  color       String   @default("from-amber-400 to-orange-500")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inovasi {
  id          String   @id @default(cuid())
  title       String
  date        String
  description String
  content     String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pengaduan {
  id        String   @id @default(cuid())
  judul     String
  pesan     String
  status    String   @default("Belum Dibaca") // 'Belum Dibaca', 'Dibaca'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
